# RPC Configuration
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/VDsFz_Ooaj0-4vaVrIxOd
ALCHEMY_WEBSOCKET_URL=wss://polygon-mainnet.g.alchemy.com/v2/VDsFz_Ooaj0-4vaVrIxOd
POLYGON_RPC_URL=https://polygon-rpc.com

# Polymarket API Configuration
POLYMARKET_API_KEY=your_polymarket_api_key_here

# Wallet Configuration (NEVER commit real private keys)
PRIVATE_KEY=your_private_key_here

# Markets to Monitor (comma-separated market IDs)
MONITORED_MARKETS=market_1,market_2,market_3

# Risk Management
MAX_POSITION_SIZE=10000
MAX_EXPOSURE_PER_MARKET=25000
MAX_TOTAL_EXPOSURE=100000
MAX_SLIPPAGE=0.005
STOP_LOSS_PERCENTAGE=0.02
HEDGE_TIMEOUT=30000
MAX_OPEN_POSITIONS=10

# Strategy Configuration
STRATEGY_THRESHOLDS=0.95,0.92,0.90
POSITION_SIZING=KELLY
BASE_SIZE=1000
MAX_LEVERAGE=3.0

# Execution Configuration
MAX_GAS_PRICE=100000000000
MAX_EXECUTION_SLIPPAGE=0.01
CONFIRMATION_BLOCKS=2

# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=development

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Backtesting Configuration
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION_RATE=0.001
BACKTEST_SLIPPAGE_MODEL=DYNAMIC
BACKTEST_LATENCY_MODEL=REALISTIC
