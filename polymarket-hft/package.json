{
  "name": "polymarket-hft",
  "version": "1.0.0",
  "description": "High-frequency trading system for Polymarket binary prediction markets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "backtest": "ts-node src/backtesting/backtester.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "bot:test": "ts-node src/test-web.ts",
    "bot:real": "ts-node src/bot-real.ts"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.6.2",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "ethers": "^5.7.2",
    "express": "^5.2.1",
    "lodash": "^4.17.21",
    "pg": "^8.11.3",
    "prom-client": "^15.0.0",
    "redis": "^4.6.10",
    "socket.io": "^4.8.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/events": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.10.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
