# API Configuration
VITE_API_URL=http://localhost:8000
VITE_ML_SERVICE_URL=http://localhost:8001

# Application Configuration
VITE_APP_NAME=Face Recognition MVP
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Storage Configuration
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# MinIO Configuration (if using direct upload)
VITE_MINIO_ENDPOINT=localhost:9000
VITE_MINIO_ACCESS_KEY=minioadmin
VITE_MINIO_SECRET_KEY=minioadmin123
VITE_MINIO_BUCKET_NAME=face-recognition
