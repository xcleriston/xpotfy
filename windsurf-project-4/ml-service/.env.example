# ML Service Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8001

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/face_recognition

# Redis
REDIS_URL=redis://localhost:6379

# ML Configuration
MODEL_PATH=./models
FACE_DETECTION_MODEL=haarcascade_frontalface_default.xml
FACE_RECOGNITION_MODEL=face_recognition_model.h5
EMBEDDING_MODEL=facenet_model.h5

# Face Detection Settings
FACE_DETECTION_CONFIDENCE_THRESHOLD=0.7
MIN_FACE_SIZE=48
MAX_FACE_SIZE=512

# Face Recognition Settings
FACE_RECOGNITION_THRESHOLD=0.6
EMBEDDING_DIMENSION=512

# Image Processing
MAX_IMAGE_SIZE=4096
JPEG_QUALITY=85
SUPPORTED_FORMATS=JPEG,PNG,WEBP

# Performance
MAX_CONCURRENT_PROCESSING=4
BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8002

# Cache
CACHE_TTL=3600
EMBEDDING_CACHE_SIZE=10000

# Security
SECRET_KEY=ml-service-secret-key-change-in-production
ALGORITHM=HS256

# External Services
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=face-recognition

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
