# Ensure package-lock.json is generated with exact versions
package-lock=true

# Use the latest npm
engine-strict=true

# Don't run optional dependencies
optional=false

# Don't run scripts from package.json on install
ignore-scripts=false

# Set the package manager to npm
engine-strict=true

# Disable package-lock.json for workspaces
package-lock=false

# Use the latest Node.js LTS version
node-version=18.x

# Set the registry to the public npm registry
registry=https://registry.npmjs.org/
