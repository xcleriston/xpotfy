# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME="Fire Horse (Test)"
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=test
VITE_APP_DEBUG=true

# Auth Configuration
VITE_AUTH_TOKEN_KEY=test_auth_token
VITE_REFRESH_TOKEN_KEY=test_refresh_token
VITE_TOKEN_EXPIRATION=1

# Feature Flags
VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_FORGOT_PASSWORD=true
VITE_FEATURE_SOCIAL_LOGIN=false

# Analytics
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# External Services
VITE_GOOGLE_MAPS_API_KEY=test_key
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# WebSocket
VITE_WS_URL=ws://localhost:5000

# PWA Configuration
VITE_PWA_ENABLED=false

# i18n Configuration
VITE_I18N_LOCALE=en-US
VITE_I18N_FALLBACK_LOCALE=en-US
VITE_I18N_SUPPORTED_LOCALES="en-US"

# Theme Configuration
VITE_THEME_COLOR_PRIMARY="#3182ce"
VITE_THEME_COLOR_SECONDARY="#805ad5"
VITE_THEME_COLOR_SUCCESS="#38a169"
VITE_THEME_COLOR_WARNING="#dd6b20"
VITE_THEME_COLOR_DANGER="#e53e3e"
VITE_THEME_COLOR_INFO="#3182ce"
VITE_THEME_COLOR_LIGHT="#f7fafc"
VITE_THEME_COLOR_DARK="#1a202c"

# Feature Toggles
VITE_FEATURE_DARK_MODE=false
VITE_FEATURE_NOTIFICATIONS=false
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_MAINTENANCE=false

# Development Tools
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_ENABLE_REACT_QUERY_DEVTOOLS=false
