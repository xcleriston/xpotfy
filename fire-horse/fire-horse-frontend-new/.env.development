# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME="Fire Horse"
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development
VITE_APP_DEBUG=true

# Auth Configuration
VITE_AUTH_TOKEN_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRATION=7

# Feature Flags
VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_FORGOT_PASSWORD=true
VITE_FEATURE_SOCIAL_LOGIN=false

# Analytics
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# External Services
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLIC_KEY=

# WebSocket
VITE_WS_URL=ws://localhost:5000

# PWA Configuration
VITE_PWA_ENABLED=false
VITE_PWA_NAME="Fire Horse"
VITE_PWA_SHORT_NAME="FireHorse"
VITE_PWA_THEME_COLOR="#3182ce"
VITE_PWA_BACKGROUND_COLOR="#ffffff"

# i18n Configuration
VITE_I18N_LOCALE=pt-BR
VITE_I18N_FALLBACK_LOCALE=pt-BR
VITE_I18N_SUPPORTED_LOCALES="pt-BR,en-US,es-ES"

# Theme Configuration
VITE_THEME_COLOR_PRIMARY="#3182ce"
VITE_THEME_COLOR_SECONDARY="#805ad5"
VITE_THEME_COLOR_SUCCESS="#38a169"
VITE_THEME_COLOR_WARNING="#dd6b20"
VITE_THEME_COLOR_DANGER="#e53e3e"
VITE_THEME_COLOR_INFO="#3182ce"
VITE_THEME_COLOR_LIGHT="#f7fafc"
VITE_THEME_COLOR_DARK="#1a202c"

# Feature Toggles
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_MAINTENANCE=false

# Development Tools
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true
