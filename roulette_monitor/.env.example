# Configurações do Navegador
BROWSER_HEADLESS=true
BROWSER_SLOWMO=0
BROWSER_WIDTH=1366
BROWSER_HEIGHT=768

# Configurações da Roleta
ROULETTE_URL=https://blaze.bet.br/games/roleta-brasileira
ROULETTE_GAME_ID=roleta-brasileira
ROULETTE_GAME_NAME=Roleta Brasileira
ROULETTE_PROVIDER=blaze
ROULETTE_CHECK_INTERVAL=10000
ROULETTE_MAX_RECONNECTION_ATTEMPTS=5
ROULETTE_RECONNECTION_DELAY=60000

# Configurações do Banco de Dados
DATABASE_PATH=./data/roulette.db
DATABASE_MAX_SIZE=100
DATABASE_MAX_RECORDS=0

# Configurações de Log
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_PATH=./logs/roulette_collector.log
LOG_MAX_FILE_SIZE=10485760 # 10MB
LOG_MAX_FILES=5

# Configurações de Monitoramento
MONITORING_ENABLE_STATUS=true
MONITORING_STATUS_PORT=3001
MONITORING_STATUS_ENDPOINT=/status
